{
  "name": "wavely-server",
  "version": "0.1.0",
  "description": "Backend server for Wavely Platform",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon --exec node --loader ts-node/esm src/index.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrations": "node --loader ts-node/esm src/database/migrations.js",
    "seed": "node --loader ts-node/esm src/database/seed.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "dotenv": "^16.0.0",
    "pg": "^8.10.0",
    "sequelize": "^6.35.0",
    "redis": "^4.6.0",
    "bullmq": "^4.15.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "express-validator": "^7.0.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "razorpay": "^2.8.0",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-github2": "^0.1.12",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.17",
    "jest": "^29.5.0"
  }
}
